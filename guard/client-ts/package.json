{
  "name": "hyperion-guard-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Hyperion Guard on Solana: build Guarded Vault instructions, ask the Guard, attach its co-signature.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "demo": "node examples/devnet.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
